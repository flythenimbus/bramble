{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bramble-relay",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-18",
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Relay"]
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "Relay",
				"name": "RELAY"
			}
		]
	},
	"observability": {
		"enabled": true,
		// One log per relayed message would blow the free plan's 200k logs/day; analytics still count them.
		"logs": { "invocation_logs": false }
	},
	"upload_source_maps": true
}
