{
	"name": "bramble",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"prepare": "git config core.hooksPath .githooks",
		"build": "pnpm --filter @vault/platform-extension run build",
		"bundle": "pnpm --filter @vault/platform-extension run bundle && node scripts/sign.ts --optional",
		"dev": "pnpm --filter @vault/platform-extension run dev",
		"wasm:build": "cd packages/crypto-wasm && wasm-pack build --target web --out-dir ../platform-extension/public/wasm",
		"wasm:verify": "node packages/crypto-wasm/verify.ts",
		"wasm:test": "cd packages/crypto-wasm && cargo test",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write  --unsafe .",
		"ci:check": "biome ci .",
		"release": "node scripts/release.ts",
		"sign": "node scripts/sign.ts",
		"tag:delete": "f(){ [ -z \"$1\" ] && { echo 'usage: pnpm run tag:delete <tag>'; exit 1; }; git tag -d \"$1\"; git push origin --delete \"$1\"; }; f",
		"test": "pnpm run wasm:test && pnpm -r run test",
		"typecheck": "pnpm -r run typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@types/node": "^24.0.0",
		"crx3": "^2.0.0",
		"ws": "^8.18.0"
	},
	"pnpm": {
		"overrides": {
			"esbuild": "^0.28.1",
			"ws": "^8.21.0"
		}
	}
}
