{
	"name": "bramble",
	"version": "0.0.0",
	"private": true,
	"workspaces": [
		"packages/core",
		"packages/platform-extension"
	],
	"scripts": {
		"build": "bun run --filter '@vault/platform-extension' build",
		"bundle": "bun run --filter '@vault/platform-extension' bundle",
		"dev": "bun run --filter '@vault/platform-extension' dev",
		"wasm:build": "cd packages/crypto-wasm && wasm-pack build --target web --out-dir ../platform-extension/public/wasm",
		"wasm:verify": "bun run packages/crypto-wasm/verify.ts",
		"wasm:test": "cd packages/crypto-wasm && cargo test",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write  --unsafe .",
		"ci:check": "biome ci .",
		"release": "bun run scripts/release.ts",
		"tag:delete": "f(){ [ -z \"$1\" ] && { echo 'usage: bun run tag:delete <tag>'; exit 1; }; git tag -d \"$1\"; git push origin --delete \"$1\"; }; f",
		"test": "bun run wasm:test && bun run --filter '*' test",
		"typecheck": "bun run --filter '*' typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@types/node": "^22.10.0"
	}
}
