# Fastlane lanes for the Bramble iOS app (Capacitor):
#   fastlane ipa      -> distribution IPA to ~/Desktop, no upload (no API key needed)
#   fastlane beta     -> build + upload to TestFlight, auto-bumping the build number
#   fastlane metadata -> upload App Store text metadata (en-US); no binary, no screenshots
#
# Both run the Capacitor pre-chain first (web bundle + native FFI libs + cap sync) so
# the archive is always current. Signing is automatic + -allowProvisioningUpdates, which
# already registers the app + AutoFillProbe extension entitlements (app group + the
# shared keychain group). Secrets live in fastlane/.env (gitignored); see .env.example.

default_platform(:ios)

REPO = `git rev-parse --show-toplevel`.strip
BUNDLE_ID = "app.bramble.mobile"
# This folder is the REPO ROOT fastlane, not the iOS project's: F-Droid's fdroidserver only
# scans `<root>/fastlane/metadata/android/`, so the Android listing has to live here and the
# iOS one keeps it company rather than sitting two directories deeper. Everything below is
# therefore addressed from the repo root.
PROJECT = "#{REPO}/packages/platform-mobile/ios/App/App.xcodeproj"
# deliver's metadata dir, nested in ios/ so the App Store listing sits beside the F-Droid one
# (metadata/android/, where fdroidserver requires it). The two could share metadata/ directly -
# deliver skips `android` as a known supply dir - but it rejects any other non-locale child, so
# with this layout metadata_path MUST be passed explicitly: the default (metadata/) errors on `ios`.
METADATA = "#{__dir__}/metadata/ios"
SCREENSHOTS = "#{__dir__}/screenshots"
# Where gym drops the .ipa + .dSYM.zip. Without this it writes to the working directory, which
# since fastlane moved to the repo root means littering the root with build artifacts. This path
# is already gitignored (packages/platform-mobile/ios/.gitignore, `App/output`).
BUILD_OUT = "#{REPO}/packages/platform-mobile/ios/App/output"
# Force DerivedData (incl. the SPM checkout cache) onto the internal disk, at a stable
# repo-local (gitignored) path. Xcode's default here points at an external Transcend
# volume that EPERMs the SPM cache and breaks `build_app` (see
# packages/platform-mobile/docs/development.md quirks 3-6). /tmp avoided that but macOS
# prunes /tmp after ~3 days, corrupting the SPM checkout (.git kept, working tree gone);
# a repo-local path is internal, not auto-pruned, and never committed.
DERIVED = "#{REPO}/packages/platform-mobile/ios/DerivedData"

# Xcode's EXPORT step rewrites the build number unless told not to: `xcodebuild -help` documents
# manageAppVersionAndBuildNumber as "Defaults to YES", and gym doesn't set it. That silently shipped
# archive+1, so the pbxproj and the release commit said N while TestFlight received N+1 (caught by
# diffing the .xcarchive's Info.plist against the exported IPA's: 207275524 vs 207275525). Off, so
# the exported binary carries exactly the number that was archived.
#
# A fresh hash per call, not a constant: gym mutates what it's handed (it merges `method` in), so a
# frozen constant raises FrozenError during packaging and a shared mutable one leaks between lanes.
def stable_export_options
  { manageAppVersionAndBuildNumber: false }
end

# App Store Connect API key, shared by the TestFlight + metadata lanes. Reads the key id /
# issuer / .p8 path from fastlane/.env (gitignored; see .env.example).
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH", "./fastlane/AuthKey.p8"),
  )
end

platform :ios do
  # Web bundle + shared Rust libs (installs ios/App/VaultCryptoFFI/) + Capacitor sync.
  # Absolute cd so it works regardless of fastlane's working directory.
  private_lane :prepare do
    sh("cd '#{REPO}' && pnpm core:build && pnpm ffi:build:ios && " \
       "cd packages/platform-mobile && npx cap sync ios")
  end

  desc "Build a distribution IPA to ~/Desktop (no upload; no API key needed)"
  lane :ipa do
    prepare
    build_app(
      project: PROJECT,
      scheme: "App",
      export_method: "app-store",
      derived_data_path: DERIVED,
      output_directory: File.expand_path("~/Desktop"),
      output_name: "Bramble-TestFlight.ipa",
      xcargs: "-allowProvisioningUpdates",
      export_options: stable_export_options,
    )
    UI.success("IPA at ~/Desktop/Bramble-TestFlight.ipa")
  end

  desc "Build + upload to TestFlight (monotonic timestamp build number)"
  lane :beta do
    key = asc_api_key
    prepare
    # Build number = seconds since 2020. Strictly increasing and never collides, unlike
    # `latest_testflight_build_number + 1`, which queries App Store Connect and lags while
    # builds process -> it kept recomputing already-used numbers ("Redundant Binary Upload").
    # `pnpm run release ios` precomputes the same value and passes it via BRAMBLE_IOS_BUILD so the
    # release commit it makes names the build that actually lands on TestFlight (iOS cuts no tag);
    # a bare `fastlane beta` computes its own.
    next_build = (ENV["BRAMBLE_IOS_BUILD"] || (Time.now.to_i - 1_577_836_800)).to_i
    # Pin CURRENT_PROJECT_VERSION at build time (both the app + extension consume it). `pnpm run
    # release ios` commits this same number to the pbxproj (mirroring the Android versionCode), so
    # the xcarg just guarantees the built binary matches what was passed in, and keeps a bare
    # `fastlane beta` working when nothing was committed. stable_export_options keeps export from
    # re-stamping it afterwards.
    build_app(
      project: PROJECT,
      scheme: "App",
      export_method: "app-store",
      derived_data_path: DERIVED,
      output_directory: BUILD_OUT,
      xcargs: "CURRENT_PROJECT_VERSION=#{next_build} -allowProvisioningUpdates",
      export_options: stable_export_options,
    )
    upload_to_testflight(api_key: key, skip_waiting_for_build_processing: true)
    UI.success("Uploaded build #{next_build} to TestFlight")
  end

  desc "Upload App Store metadata (en-US text only; no binary, no screenshots)"
  lane :metadata do
    # Reads fastlane/metadata/ios/**. Fill in the real privacy + support
    # URLs (metadata/ios/en-US/*_url.txt) before running. App Review contact + notes are NOT
    # managed here (no review_information/ folder); set them in App Store Connect directly.
    # app_version tracks the project's MARKETING_VERSION, so deliver targets (and creates,
    # if missing) that App Store version - no need to edit this lane when the version bumps.
    #
    # Screenshots: uploaded only when screenshots/<locale>/ actually holds image files. When
    # it does, overwrite_screenshots replaces App Store Connect's set with the repo's, so any
    # changes get pushed; when the folder is empty we skip them so a run never wipes the
    # screenshots already on App Store Connect.
    shots = Dir.glob(File.join(SCREENSHOTS, "**", "*.{png,PNG,jpg,JPG,jpeg,JPEG}"))
    has_shots = !shots.empty?
    UI.message(
      has_shots ? "Found #{shots.count} screenshot(s); syncing the App Store set to match" \
                : "No screenshots in screenshots/; skipping screenshots"
    )
    # sync_screenshots reconciles App Store Connect against the local set (adds
    # missing, deletes extras) instead of overwrite_screenshots' delete-then-reupload.
    # overwrite only clears once at the start, so deliver's flaky upload/poll retries
    # (Apple 500s on "waiting for screenshots to appear") re-upload shots that already
    # landed and pile up duplicates; sync removes those on the next run. Still beta, so
    # it needs the env gate as well. See fastlane#16924 / #22193.
    ENV["FASTLANE_ENABLE_BETA_DELIVER_SYNC_SCREENSHOTS"] = "true" if has_shots
    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: BUNDLE_ID,
      app_version: get_version_number(xcodeproj: PROJECT, target: "App"),
      metadata_path: METADATA,
      screenshots_path: SCREENSHOTS,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: !has_shots,
      sync_screenshots: has_shots,
      force: true,                          # skip the HTML preview confirmation
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
    )
  end
end
