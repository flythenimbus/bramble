# Copy to `.env` (gitignored) and fill in, for the `fastlane beta` lane.
#
# Create the key in App Store Connect:
#   Users and Access -> Integrations -> App Store Connect API -> generate an API key
#   (role: App Manager is enough). Download the .p8 ONCE and save it as
#   <repo root>/fastlane/AuthKey.p8 (also gitignored).
#
# The `fastlane ipa` lane needs none of this.
# Paths below are relative to the repo root (fastlane runs from there).

ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_PATH=./fastlane/AuthKey.p8
