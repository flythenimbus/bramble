{
	"manifest_version": 3,
	"name": "Bramble transport-race contract fixture",
	"version": "1.0.0",
	"background": {
		"scripts": ["background.js"],
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["http://127.0.0.1/*", "http://localhost/*"],
			"js": ["content.js"],
			"run_at": "document_start",
			"all_frames": true
		}
	],
	"host_permissions": ["http://127.0.0.1/*", "http://localhost/*"]
}
