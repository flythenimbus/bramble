# Copy to .env.local (gitignored) and fill in. Loaded by the i18n translate
# scripts via `node --env-file-if-exists=.env.local`.

# Use DeepSeek (OpenAI-compatible API) for translation instead of local Ollama.
# When set, scripts/i18n/ollama.mjs routes to DeepSeek; otherwise it uses Ollama.
DEEPSEEK_API_KEY=

# Optional overrides:
# I18N_MODEL=deepseek-chat          # DeepSeek model (default), or an Ollama tag
# I18N_API_BASE=https://api.deepseek.com
# OLLAMA_HOST=http://localhost:11434
# I18N_CHUNK=10

# macOS code-signing identity for `pnpm build:desktop`. Not cosmetic: macOS ties a keychain
# item's ACL to the reading binary's code signature, so an unsigned desktop build prompts for
# the login password every launch and browser pairing looks broken. Leave unset to build
# unsigned. `security find-identity -v -p codesigning` lists what you have.
# APPLE_SIGNING_IDENTITY="Developer ID Application: Your Company (TEAMID)"

# Notarization, only needed for builds that run on another machine.
# APPLE_ID=
# APPLE_PASSWORD=          # app-specific password, not your Apple ID password
# APPLE_TEAM_ID=

# APT releases
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
BRAMBLE_APT_GPG_KEY=
CF_ZONE_ID=
CF_CACHE_PURGE_TOKEN=
