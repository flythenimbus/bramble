{
	"$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**/*.{ts,tsx,js,jsx,json,jsonc}",
			"!**/node_modules",
			"!**/dist",
			"!packages/core-rust/target",
			"!packages/platform-extension/public/wasm",
			"!packages/platform-extension/src/fixtures/imports",
			"!icon",
			"!**/*.lockb"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"noAutofocus": "off",
				"useButtonType": "off",
				"noLabelWithoutControl": "off"
			},
			"suspicious": {
				"noExplicitAny": "off"
			},
			"style": {
				"noNonNullAssertion": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "all",
			"semicolons": "always",
			"arrowParentheses": "always"
		}
	},
	"overrides": [
		{
			"includes": [
				"packages/core/src/app/components/ui/**",
				"packages/core/src/app/components/figma/**"
			],
			"linter": {
				"rules": {
					"a11y": {
						"useButtonType": "off",
						"noStaticElementInteractions": "off",
						"useKeyWithClickEvents": "off",
						"useSemanticElements": "off",
						"noNoninteractiveElementToInteractiveRole": "off",
						"useFocusableInteractive": "off",
						"useAriaPropsForRole": "off",
						"useAltText": "off",
						"noRedundantRoles": "off",
						"noRedundantAlt": "off",
						"noLabelWithoutControl": "off"
					},
					"security": {
						"noDangerouslySetInnerHtml": "off"
					},
					"suspicious": {
						"noArrayIndexKey": "off",
						"noDocumentCookie": "off"
					},
					"style": {
						"useTemplate": "off"
					},
					"correctness": {
						"useExhaustiveDependencies": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.css"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnknownMediaFeatureName": "off",
						"noInvalidPositionAtImportRule": "off"
					}
				}
			}
		}
	]
}
