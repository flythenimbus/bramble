{
  "sourceLanguage": "en",
  "strings": {
    "Add %@ to “%@” so Bramble offers it here automatically?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zu „%@” hinzufügen, damit Bramble es hier automatisch anbietet?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Añadir %@ a “%@” para que Bramble lo ofrezca aquí automáticamente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter %@ à «%@» pour que Bramble le propose ici automatiquement ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungere %@ a “%@” così Bramble lo propone qui automaticamente?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar %@ a “%@” para o Bramble oferecer aqui automaticamente?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) “%@”에 추가하여 Bramble이 여기에서 자동으로 제공하도록 하시겠습니까?"
          }
        }
      }
    },
