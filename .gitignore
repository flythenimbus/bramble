node_modules/
dist/
dist-chromium/
dist-firefox/

# Astro build cache
.astro/
website/.astro/

# Wrangler local state
.wrangler/
web-ext-artifacts/
bramble*.zip
bramble*.crx
bramble*.xpi
*.log
.DS_Store

# Rust / WASM
packages/core-rust/target/
# Cargo.lock IS committed: this crate ships compiled artifacts (jniLibs + wasm) in the
# released apps, so the dependency graph must be pinned. Without it F-Droid's rebuild of
# a tag resolves newer patch releases and no longer matches the published binary.
packages/platform-extension/public/wasm/

# Signing keys must never be committed (see docs/release-signing.md)
*.pem
*.age
*.jks
*.keystore
# Google / Chrome Web Store service-account keys (secret JSON private keys)
*-service-account.json
*.iam.gserviceaccount.com.json
bramble-502002-*.json

# Local env (API keys, never tracked)
.env.local
.env*.local

# Playwright E2E artifacts (the browsers live in ~/.cache/ms-playwright, not the repo)
test-results/
playwright-report/
.playwright/

# Unsigned APKs from the reproducible-build container (docker-compose android-repro)
build-fdroid/
