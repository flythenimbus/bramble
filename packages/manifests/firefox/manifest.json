{
	"manifest_version": 3,
	"name": "Bramble",
	"version": "1.21.0",
	"default_locale": "en",
	"description": "__MSG_extDescription__",
	"browser_specific_settings": {
		"gecko": {
			"id": "firefox@bramble.app",
			"strict_min_version": "128.0",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	},
	"action": {
		"default_popup": "popup.html",
		"default_title": "Bramble",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png"
		},
		"theme_icons": [
			{ "light": "icons/icon-16-dark.png", "dark": "icons/icon-16.png", "size": 16 },
			{ "light": "icons/icon-32-dark.png", "dark": "icons/icon-32.png", "size": 32 }
		]
	},
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"options_page": "options.html",
	"background": {
		"scripts": ["background.js"],
		"type": "module"
	},
	"permissions": ["storage", "unlimitedStorage", "alarms", "idle", "clipboardWrite", "identity"],
	"host_permissions": ["<all_urls>"],
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content-script.js"],
			"all_frames": true,
			"run_at": "document_idle"
		},
		{
			"matches": ["<all_urls>"],
			"js": ["webauthn-inpage.js"],
			"world": "MAIN",
			"all_frames": true,
			"run_at": "document_start"
		},
		{
			"matches": ["<all_urls>"],
			"js": ["webauthn-bridge.js"],
			"all_frames": true,
			"run_at": "document_start"
		}
	],
	"commands": {
		"lock-vault": {
			"description": "__MSG_cmdLockVault__"
		}
	},
	"content_security_policy": {
		"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
	},
	"web_accessible_resources": [
		{
			"resources": ["autofill-ui.html", "autofill-ui.js"],
			"matches": ["<all_urls>"]
		}
	]
}
