{
	"manifest_version": 3,
	"name": "Titanpass",
	"version": "0.0.1",
	"description": "Local-first, encrypted password manager. No server, no sync service.",
	"minimum_chrome_version": "116",
	"action": {
		"default_popup": "popup.html",
		"default_title": "Titanpass"
	},
	"options_page": "options.html",
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"permissions": [
		"storage",
		"unlimitedStorage",
		"alarms",
		"offscreen",
		"clipboardWrite",
		"activeTab"
	],
	"host_permissions": ["<all_urls>"],
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content-script.js"],
			"all_frames": false,
			"run_at": "document_idle"
		}
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
	}
}
