#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Cancel"
msgstr "Annullare"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Create new vault"
msgstr "Creare una nuova vault"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Create your vault"
msgstr "Creare la propria cassaforte"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Encrypted on your device"
msgstr "Crittografato sul dispositivo"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Enter your master password to unlock your vault"
msgstr "Inserisca la password principale per sbloccare il suo caveau."

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Enter your recovery code to unlock. After signing in, generate a new one in Settings."
msgstr "Inserisca il codice di ripristino per sbloccare. Dopo aver effettuato l'accesso, generi un nuovo codice nelle Impostazioni."

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Hide password"
msgstr "Nascondere la password"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Master password"
msgstr "Password principale"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "New to {appName}?"
msgstr "È nuovo di {appName}?"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Open in window"
msgstr "Apri nella finestra"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Opening…"
msgstr "Avviando..."

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Please enter your master password"
msgstr "Si prega di inserire la password principale"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Recovery code"
msgstr "Codice di recupero"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Set up a vault to start saving your passwords, cards, and notes."
msgstr "Configuri una cassaforte per iniziare a salvare le sue password, le sue carte e le sue note."

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Show password"
msgstr "Mostra password"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock"
msgstr "Sbloccare"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock Vault"
msgstr "Sblocca Cassaforte"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock with biometrics"
msgstr "Sblocca con biometria"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock with Face ID"
msgstr "Sblocca con Face ID"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock with master password"
msgstr "Sblocca con la password principale"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock with Optic ID"
msgstr "Sblocca con Optic ID"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock with recovery code"
msgstr "Sbloccare con il codice di recupero"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock with security key"
msgstr "Sbloccare con chiave di sicurezza"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock with Touch ID"
msgstr "Sblocca con Touch ID"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock your vault with your security key"
msgstr "Sblocchiate la vostra cassaforte con la chiave di sicurezza."

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlocking…"
msgstr "Sblocco…"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Verifying…"
msgstr "Verifica…"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Waiting for your key…"
msgstr "In attesa della chiave…"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Welcome to {appName}"
msgstr "Benvenuto in {appName}"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Your browser may ask for access to your vault file when you unlock."
msgstr "Il suo browser potrebbe richiedere l'accesso al file del caveau quando lo sblocca."

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Your vault stays on this device, encrypted with AES-256-GCM. Keep your master password and recovery code somewhere safe."
msgstr "Il suo caveau rimane su questo dispositivo, crittografato con AES-256-GCM. Conservi la sua password principale e il codice di recupero in un luogo sicuro."