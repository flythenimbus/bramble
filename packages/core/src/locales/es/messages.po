#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Cancel"
msgstr "Cancelar"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Create new vault"
msgstr "Crear bóveda nueva"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Create your vault"
msgstr "Cree su bóveda"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Encrypted on your device"
msgstr "Cifrado en su dispositivo"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Enter your master password to unlock your vault"
msgstr "Introduzca la contraseña maestra para desbloquear su bóveda"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Enter your recovery code to unlock. After signing in, generate a new one in Settings."
msgstr "Introduzca el código de recuperación para desbloquear. Después de iniciar sesión, genere uno nuevo en Configuración."

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Hide password"
msgstr "Ocultar contraseña"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Master password"
msgstr "Contraseña maestra"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "New to {appName}?"
msgstr "¿Nuevo en {appName}?"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Open in window"
msgstr "Abrir en ventana"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Opening…"
msgstr "Abriendo..."

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Please enter your master password"
msgstr "Por favor, introduzca su contraseña maestra"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Recovery code"
msgstr "Código de recuperación"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Set up a vault to start saving your passwords, cards, and notes."
msgstr "Configure una bóveda para empezar a guardar sus contraseñas, tarjetas y notas."

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Show password"
msgstr "Mostrar contraseña"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock"
msgstr "Desbloquear"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock Vault"
msgstr "Desbloquear Bóveda"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock with biometrics"
msgstr "Desbloquear con biometría"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock with Face ID"
msgstr "Desbloquear con Face ID"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock with master password"
msgstr "Desbloquear con Optic ID"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock with Optic ID"
msgstr "Desbloquear con llave de seguridad"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock with recovery code"
msgstr "Desbloquear con Touch ID"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock with security key"
msgstr "Desbloquear con código de recuperación"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock with Touch ID"
msgstr "Desbloquear con contraseña maestra"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock your vault with your security key"
msgstr "Desbloquee su bóveda con su llave de seguridad"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlocking…"
msgstr "Desbloqueando…"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Verifying…"
msgstr "Verificando…"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Waiting for your key…"
msgstr "Esperando su clave…"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Welcome to {appName}"
msgstr "Bienvenido a {appName}"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Your browser may ask for access to your vault file when you unlock."
msgstr "Su navegador puede solicitar acceso al archivo de la bóveda cuando usted desbloquee."

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Your vault stays on this device, encrypted with AES-256-GCM. Keep your master password and recovery code somewhere safe."
msgstr "Su bóveda permanece en este dispositivo, cifrada con AES-256-GCM. Guarde su contraseña maestra y el código de recuperación en un lugar seguro."
