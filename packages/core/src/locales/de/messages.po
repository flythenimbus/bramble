#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Cancel"
msgstr "Abbrechen"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Create new vault"
msgstr "Neuen Tresor erstellen"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Create your vault"
msgstr "Erstellen Sie Ihren Tresor"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Encrypted on your device"
msgstr "Auf Ihrem Gerät verschlüsselt"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Enter your master password to unlock your vault"
msgstr "Geben Sie Ihr Master-Passwort ein, um den Tresor zu entsperren"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Enter your recovery code to unlock. After signing in, generate a new one in Settings."
msgstr "Geben Sie Ihren Wiederherstellungscode ein, um zu entsperren. Erstellen Sie nach der Anmeldung einen neuen Code in den Einstellungen."

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Hide password"
msgstr "Passwort ausblenden"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Master password"
msgstr "Master-Passwort"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "New to {appName}?"
msgstr "Neu bei {appName}?"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Open in window"
msgstr "Im Fenster öffnen"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Opening…"
msgstr "Öffnen..."

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Please enter your master password"
msgstr "Bitte geben Sie Ihr Master-Passwort ein"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Recovery code"
msgstr "Wiederherstellungscode"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Set up a vault to start saving your passwords, cards, and notes."
msgstr "Richten Sie einen Tresor ein, um Ihre Passwörter, Karten und Notizen zu speichern."

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Show password"
msgstr "Passwort anzeigen"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock"
msgstr "Entsperren"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock Vault"
msgstr "Tresor entsperren"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock with biometrics"
msgstr "Mit Biometrie entsperren"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock with Face ID"
msgstr "Mit Face ID entsperren"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock with master password"
msgstr "Mit Optic ID entsperren"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock with Optic ID"
msgstr "Mit Wiederherstellungscode entsperren"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock with recovery code"
msgstr "Mit Sicherheitsschlüssel entsperren"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock with security key"
msgstr "Mit Touch ID entsperren"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock with Touch ID"
msgstr "Mit Master-Passwort entsperren"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlock your vault with your security key"
msgstr "Mit Sicherheitsschlüssel entsperren"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Unlocking…"
msgstr "Entsperren…"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Verifying…"
msgstr "Überprüfung…"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Waiting for your key…"
msgstr "Warte auf Ihren Schlüssel…"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Welcome to {appName}"
msgstr "Willkommen bei {appName}"

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Your browser may ask for access to your vault file when you unlock."
msgstr "Ihr Browser kann beim Entsperren nach Zugriff auf die Tresordatei fragen."

#: packages/core/src/app/screens/Auth/Auth.tsx
msgid "Your vault stays on this device, encrypted with AES-256-GCM. Keep your master password and recovery code somewhere safe."
msgstr "Ihr Tresor bleibt auf diesem Gerät gespeichert und ist mit AES-256-GCM verschlüsselt. Bewahren Sie Ihr Masterpasswort und den Wiederherstellungscode sicher auf."
