{
	"name": "@vault/platform-extension",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm run build:chromium && pnpm run build:firefox",
		"build:chromium": "vite build",
		"build:firefox": "TARGET=firefox vite build",
		"bundle:chromium": "vite build && rm -f bramble.zip && (cd dist-chromium && zip -rq ../bramble.zip . -x '*.d.ts' 'wasm/package.json' 'wasm/.gitignore' '*.DS_Store')",
		"bundle:firefox": "TARGET=firefox vite build && rm -f bramble-firefox.zip && (cd dist-firefox && zip -rq ../bramble-firefox.zip . -x '*.d.ts' 'wasm/package.json' 'wasm/.gitignore' '*.DS_Store')",
		"lint:firefox": "web-ext lint -s dist-firefox",
		"run:firefox": "web-ext run -s dist-firefox",
		"dev": "vite build --watch --mode development",
		"typecheck": "tsc --noEmit",
		"lint": "echo 'TODO: lint'",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@vault/core": "workspace:*",
		"jsqr": "^1.4.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"tldts": "^6.1.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@lingui/babel-plugin-lingui-macro": "^6.4.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/chrome": "^0.0.270",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"jsdom": "^29.1.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.0.0",
		"typescript": "^5.5.0",
		"vite": "^8.0.13",
		"vitest": "^4.1.7",
		"web-ext": "^10.4.0"
	}
}
