<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Package visibility (Android 11+): so we can read a caller browser's real signing certificate
         (getPackageInfo GET_SIGNING_CERTIFICATES). Without this, TrustedBrowsers.signingFingerprints
         returns empty, which breaks the autofill webDomain-trust check and makes the passkey fail-loud
         log print no fingerprint. Browsers = apps handling a BROWSABLE https VIEW intent; targeted so
         we avoid the heavy QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Inbound 2FA setup: another app or a browser hands us an otpauth:// URI and
                 Android offers Bramble in the chooser. Any app on the device can fire this,
                 so an arriving URI only ever prefills a form the user submits; it never
                 writes to the vault. Deliberately MainActivity, not the :autofill process,
                 so it is nowhere near a decrypted VEK. See docs/totp-uri-handler.md. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="otpauth" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Unlock + searchable credential list for autofill. Same :autofill process as the
             service; not exported (only the service's PendingIntent launches it). -->
        <activity
            android:name=".AutofillUnlockActivity"
            android:exported="false"
            android:process=":autofill"
            android:theme="@style/BrambleAutofillTheme"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- System autofill provider. Runs in a dedicated :autofill process so its decrypted
             VEK never touches the app's webview session. -->
        <service
            android:name=".BrambleAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:process=":autofill"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <!-- Unlock + sign for the passkey provider. Same :autofill process as the credential
             service; only its PendingIntents launch it. Reuses the autofill unlock theme. -->
        <activity
            android:name=".CredentialFulfillActivity"
            android:exported="false"
            android:process=":autofill"
            android:theme="@style/BrambleAutofillTheme"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- Passkey provider via the Credential Manager (Android 14 / API 34+; the system only
             binds it there, dormant on older OSes). Same dedicated :autofill process as the
             classic service so a decrypted VEK never touches the webview session. Passkeys only;
             passwords stay on BrambleAutofillService. See docs/passkey-provider.md. -->
        <service
            android:name=".BrambleCredentialService"
            android:exported="true"
            android:label="@string/app_name"
            android:process=":autofill"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider" />
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
</manifest>
