<?xml version="1.0" encoding="utf-8"?>
<!-- Capabilities advertised to the Android Credential Manager. Passkeys only: passwords stay
     on the classic AOSP AutofillService (BrambleAutofillService). See docs/passkey-provider.md. -->
<credential-provider xmlns:android="http://schemas.android.com/apk/res/android">
    <capabilities>
        <capability name="androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
    </capabilities>
</credential-provider>
