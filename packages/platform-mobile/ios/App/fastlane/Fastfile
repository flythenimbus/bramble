# Fastlane lanes for the Bramble iOS app (Capacitor):
#   fastlane ipa      -> distribution IPA to ~/Desktop, no upload (no API key needed)
#   fastlane beta     -> build + upload to TestFlight, auto-bumping the build number
#   fastlane metadata -> upload App Store text metadata (en-US); no binary, no screenshots
#
# Both run the Capacitor pre-chain first (web bundle + native FFI libs + cap sync) so
# the archive is always current. Signing is automatic + -allowProvisioningUpdates, which
# already registers the app + AutoFillProbe extension entitlements (app group + the
# shared keychain group). Secrets live in fastlane/.env (gitignored); see .env.example.

default_platform(:ios)

REPO = `git rev-parse --show-toplevel`.strip
BUNDLE_ID = "app.bramble.mobile"
# Force DerivedData (incl. the SPM checkout cache) onto the internal disk. Xcode's
# default here points at an external Transcend volume that EPERMs the SPM cache and
# breaks `build_app` (see packages/platform-mobile/docs/development.md quirks 3-6).
DERIVED = "/tmp/bramble-derived-data"

# App Store Connect API key, shared by the TestFlight + metadata lanes. Reads the key id /
# issuer / .p8 path from fastlane/.env (gitignored; see .env.example).
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH", "./fastlane/AuthKey.p8"),
  )
end

platform :ios do
  # Web bundle + shared Rust libs (installs ios/App/VaultCryptoFFI/) + Capacitor sync.
  # Absolute cd so it works regardless of fastlane's working directory.
  private_lane :prepare do
    sh("cd '#{REPO}' && pnpm core:build && pnpm ffi:build:ios && " \
       "cd packages/platform-mobile && npx cap sync ios")
  end

  desc "Build a distribution IPA to ~/Desktop (no upload; no API key needed)"
  lane :ipa do
    prepare
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      derived_data_path: DERIVED,
      output_directory: File.expand_path("~/Desktop"),
      output_name: "Bramble-TestFlight.ipa",
      xcargs: "-allowProvisioningUpdates",
    )
    UI.success("IPA at ~/Desktop/Bramble-TestFlight.ipa")
  end

  desc "Build + upload to TestFlight (monotonic timestamp build number)"
  lane :beta do
    key = asc_api_key
    prepare
    # Build number = seconds since 2020. Strictly increasing and never collides, unlike
    # `latest_testflight_build_number + 1`, which queries App Store Connect and lags while
    # builds process -> it kept recomputing already-used numbers ("Redundant Binary Upload").
    next_build = Time.now.to_i - 1_577_836_800
    # Override CURRENT_PROJECT_VERSION at build time (both the app + extension consume it)
    # instead of mutating the pbxproj, so the working tree stays clean.
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      derived_data_path: DERIVED,
      xcargs: "CURRENT_PROJECT_VERSION=#{next_build} -allowProvisioningUpdates",
    )
    upload_to_testflight(api_key: key, skip_waiting_for_build_processing: true)
    UI.success("Uploaded build #{next_build} to TestFlight")
  end

  desc "Upload App Store metadata (en-US text only; no binary, no screenshots)"
  lane :metadata do
    # Reads fastlane/metadata/** (only en-US for now). Fill in the real privacy + support
    # URLs (metadata/en-US/*_url.txt) and the review contact before running. Screenshots are
    # skipped until screenshots/en-US/ is populated (see screenshots/README.md).
    # app_version tracks the project's MARKETING_VERSION, so deliver targets (and creates,
    # if missing) that App Store version - no need to edit this lane when the version bumps.
    upload_to_app_store(
      api_key: asc_api_key,
      app_identifier: BUNDLE_ID,
      app_version: get_version_number(xcodeproj: "App.xcodeproj", target: "App"),
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      force: true,                          # skip the HTML preview confirmation
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
    )
  end
end
