    "This vault has no master password, or it hasn't synced. Open Bramble, unlock it once, then retry.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This vault has no master password, or it hasn't synced. Open Bramble, unlock it once, then retry."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Tresor hat kein Masterpasswort oder er wurde nicht synchronisiert. Öffnen Sie Bramble, entsperren Sie ihn einmal und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta bóveda no tiene contraseña maestra o aún no se ha sincronizado. Abra Bramble, desbloquéela una vez y luego inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce coffre-fort ne possède pas de mot de passe maître ou il n'a pas été synchronisé. Ouvrez Bramble, déverrouillez-le une fois, puis réessayez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cofre não possui senha mestra ou ainda não sincronizou. Abra o Bramble, desbloqueie-o uma vez e tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo vault non ha una password principale o non è stato sincronizzato. Apri Bramble, sbloccalo una volta e riprova."
          }
        }
      }
    },
