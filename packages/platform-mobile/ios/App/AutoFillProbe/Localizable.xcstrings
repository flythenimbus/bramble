    "This device's saved key is out of date. Enter your master password.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der auf diesem Gerät gespeicherte Schlüssel ist veraltet. Geben Sie Ihr Master-Passwort ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave guardada de este dispositivo está desactualizada. Introduzca su contraseña maestra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé enregistrée sur cet appareil est obsolète. Saisissez votre mot de passe principal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave salva deste dispositivo está desatualizada. Digite sua senha mestra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave salvata su questo dispositivo non è aggiornata. Inserisca la sua password principale."
          }
        }
      }
    },
    "This vault has no master password, or it hasn't synced. Open Bramble, unlock it once, then retry.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Tresor hat kein Masterpasswort oder er wurde nicht synchronisiert. Öffnen Sie Bramble, entsperren Sie ihn einmal und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This vault has no master password, or it hasn't synced. Open Bramble, unlock it once, then retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta bóveda no tiene contraseña maestra o aún no se ha sincronizado. Abra Bramble, desbloquéela una vez y luego inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce coffre-fort ne possède pas de mot de passe maître ou il n'a pas été synchronisé. Ouvrez Bramble, déverrouillez-le une fois, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo vault non ha una password principale o non è stato sincronizzato. Apri Bramble, sbloccalo una volta e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cofre não possui senha mestra ou ainda não sincronizou. Abra o Bramble, desbloqueie-o uma vez e tente novamente."
          }
        }
      }
    },
