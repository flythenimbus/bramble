---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import { formatPostDate, getPosts } from "@/posts";

const posts = await getPosts();
---

<Layout
	title="Blog"
	description="Release notes and engineering write-ups from the Bramble project."
	path="/blog"
>
	<Header />
	<main class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
		<header class="mb-12">
			<h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Blog</h1>
			<p class="mt-3 text-muted-foreground">
				Release notes and engineering write-ups from the Bramble project.
			</p>
		</header>

		{posts.length === 0 && <p class="text-muted-foreground">Nothing here yet.</p>}

		<ul class="flex flex-col gap-10">
			{
				posts.map((post) => (
					<li>
						<article>
							<time
								datetime={post.data.pubDate.toISOString()}
								class="text-sm text-muted-foreground"
							>
								{formatPostDate(post.data.pubDate)}
							</time>
							<h2 class="mt-1 text-xl font-semibold tracking-tight">
								<a href={`/blog/${post.id}`} class="transition-colors hover:text-primary">
									{post.data.title}
								</a>
							</h2>
							<p class="mt-2 text-muted-foreground">{post.data.description}</p>
							<a
								href={`/blog/${post.id}`}
								class="mt-3 inline-block text-sm font-medium transition-colors hover:text-primary"
							>
								Read more &rarr;
							</a>
						</article>
					</li>
				))
			}
		</ul>
	</main>
	<Footer />
</Layout>
