---
import ArrowRight from "@tabler/icons/outline/arrow-right.svg";
import DeviceDesktop from "@tabler/icons/outline/device-desktop.svg";
import Devices from "@tabler/icons/outline/devices.svg";
import FileImport from "@tabler/icons/outline/file-import.svg";
import HelpCircle from "@tabler/icons/outline/help-circle.svg";
import DocsHelp from "@/components/docs/DocsHelp.astro";
import DocsSearch from "@/components/docs/DocsSearch.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { type DocSection, docHref, getDocs, groupBySection, sectionOf } from "@/docs";
import Layout from "@/layouts/Layout.astro";
import "@/styles/docs.css";

const ICONS: Record<DocSection["id"], typeof Devices> = {
	import: FileImport,
	sync: Devices,
	desktop: DeviceDesktop,
};

const docs = await getDocs();
const groups = groupBySection(docs);
const questions = docs.filter((d) => d.data.kind === "question");
---

<Layout
	title="Docs"
	description="Guides and answers for Bramble on your phone, computer and browser."
	path="/docs"
>
	<Header />
	<main>
		<section class="border-b border-border/60 bg-muted/30">
			<div class="mx-auto max-w-2xl px-4 py-16 text-center sm:px-6 sm:py-20">
				<h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">How can we help?</h1>
				<p class="mt-3 text-muted-foreground">
					Guides and answers for Bramble on your phone, computer and browser.
				</p>
				<div class="mt-8 text-left">
					<DocsSearch id="hero-search" variant="hero" syncUrl />
				</div>
				<nav aria-label="Topics" class="mt-5 flex flex-wrap justify-center gap-2">
					{
						groups.map(({ section }) => (
							<a
								href={`#${section.id}`}
								class="rounded-full border border-border bg-background px-3 py-1 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
							>
								{section.title}
							</a>
						))
					}
				</nav>
			</div>
		</section>

		<div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
			<h2 class="sr-only">Topics</h2>
			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				{
					groups.map(({ section, docs }) => {
						const Icon = ICONS[section.id];
						return (
							<section
								id={section.id}
								aria-labelledby={`${section.id}-title`}
								class="scroll-mt-24 rounded-xl border border-border bg-card p-6"
							>
								<div class="flex size-10 items-center justify-center rounded-lg bg-muted">
									<Icon class="size-5" aria-hidden="true" />
								</div>
								<h3 id={`${section.id}-title`} class="mt-4 text-lg font-semibold tracking-tight">
									{section.title}
								</h3>
								<p class="mt-1 text-sm text-muted-foreground">{section.description}</p>
								<ul class="mt-4 flex flex-col gap-1 border-t border-border pt-4">
									{docs.map((doc) => (
										<li>
											<a
												href={docHref(doc)}
												class="group flex items-start gap-2 rounded-md py-1 text-sm transition-colors hover:text-foreground"
											>
												{doc.data.kind === "question" ? (
													<HelpCircle class="mt-0.5 size-4 shrink-0 text-muted-foreground" aria-label="Q&A" />
												) : (
													<ArrowRight class="mt-0.5 size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
												)}
												<span class="group-hover:underline group-hover:underline-offset-2">
													{doc.data.title}
												</span>
											</a>
										</li>
									))}
								</ul>
							</section>
						);
					})
				}
			</div>

			{
				questions.length > 0 && (
					<section aria-labelledby="questions-title" class="mt-16">
						<h2 id="questions-title" class="text-xl font-semibold tracking-tight">
							Common questions
						</h2>
						<ul class="mt-5 grid gap-x-10 gap-y-1 md:grid-cols-2">
							{questions.map((doc) => (
								<li>
									<a
										href={docHref(doc)}
										class="flex items-baseline justify-between gap-4 border-b border-border py-3 transition-colors hover:text-foreground"
									>
										<span class="font-medium">{doc.data.title}</span>
										<span class="shrink-0 text-xs text-muted-foreground">
											{sectionOf(doc).title}
										</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}

			<div class="mt-16">
				<DocsHelp />
			</div>
		</div>
	</main>
	<Footer />
</Layout>
