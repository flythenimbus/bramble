---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import "@/styles/prose.css";

interface Props {
	title: string;
	description?: string;
	path?: string;
	/** Optional line under the heading, e.g. "Effective date: 23 June 2026". */
	meta?: string;
}

const { title, description, path, meta } = Astro.props;
---

<Layout title={title} description={description} path={path}>
	<Header />
	<main id="main" tabindex="-1" class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
		<header class="mb-10">
			<h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
			{meta && <p class="mt-3 text-sm text-muted-foreground">{meta}</p>}
		</header>
		<article class="prose">
			<slot />
		</article>
	</main>
	<Footer />
</Layout>
