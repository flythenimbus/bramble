---
import "@/styles/starwind.css";
import { SITE } from "@/consts";

interface Props {
	title?: string;
	description?: string;
	/** Page path for the canonical URL, e.g. "/privacy". */
	path?: string;
}

const {
	title,
	description = SITE.description,
	path = "/",
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
const canonical = new URL(path, SITE.url).href;
const ogImage = new URL("/icon-512.png", SITE.url).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />

		<title>{pageTitle}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#242424" media="(prefers-color-scheme: dark)" />

		{/* Set the theme before first paint so there is no light/dark flash. Mirrors
		    the extension's behavior and reads the same `colorTheme` key the Starwind
		    ThemeToggle writes. `theme-ready` hands the background to the .dark class. */}
		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem("colorTheme");
					var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
					var dark = stored
						? stored === "dark" || (stored === "system" && prefersDark)
						: prefersDark;
					document.documentElement.classList.toggle("dark", dark);
				} catch (e) {}
				document.documentElement.classList.add("theme-ready");
			})();
		</script>
	</head>
	<body class="min-h-screen antialiased">
		<slot />

		{/* Personalize the "Add to your browser" buttons: point them at the right store
		    and, where the browser is nameable, relabel to "Add to <Browser>". The markup
		    defaults to the Chrome Web Store and a generic label, so with JS off or an
		    unknown browser (Safari, Arc) it degrades cleanly. */}
		<script>
			import { LINKS } from "@/consts";
			import { browserName, detect } from "@/scripts/platform";

			const href = detect().family === "gecko" ? LINKS.firefox : LINKS.chrome;
			for (const el of document.querySelectorAll("[data-install-browser]")) {
				el.setAttribute("href", href);
			}

			// Resolved rather than read: Brave hides itself from the user agent string.
			browserName().then((name) => {
				if (!name) return;
				for (const el of document.querySelectorAll("[data-install-label]")) {
					el.textContent = `Add to ${name}`;
				}
			});
		</script>
	</body>
</html>
