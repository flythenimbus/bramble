---
import BrandGithub from "@tabler/icons/outline/brand-github.svg";
import { Button } from "@/components/starwind/button";
import { ThemeToggle } from "@/components/starwind/theme-toggle";
import { LINKS, NAV, SITE } from "@/consts";
---

<header
	class="sticky top-0 z-50 w-full border-b border-border/60 bg-background/80 backdrop-blur-md"
>
	<div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4 sm:px-6">
		<a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight">
			<img src="/icon-512.png" alt="" width="28" height="28" class="size-7 rounded-md" />
			<span class="text-lg">{SITE.name}</span>
		</a>

		<nav class="ml-4 hidden items-center gap-1 md:flex" aria-label="Primary">
			{
				NAV.map((item) => (
					<a
						href={item.href}
						class="rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="ml-auto flex items-center gap-1.5">
			<Button
				variant="ghost"
				size="icon-sm"
				href={LINKS.github}
				target="_blank"
				rel="noopener"
				aria-label="Bramble on GitHub"
			>
				<BrandGithub />
			</Button>
			<ThemeToggle size="sm" class="hidden sm:inline-flex" />
			<Button
				href={LINKS.chrome}
				data-install-browser
				target="_blank"
				rel="noopener"
				size="sm"
				class="ml-1"
			>
				Get Bramble
			</Button>
		</div>
	</div>
</header>
