---
import Mail from "@tabler/icons/outline/mail.svg";
import { Button } from "@/components/starwind/button";
import { BUTTONDOWN } from "@/consts";

// Buttondown's embed endpoint. It must be the action of a standard HTML form:
// the response carries the CAPTCHA and validation flows the subscriber has to
// follow, so it can never be submitted with fetch.
const action = `https://buttondown.com/api/emails/embed-subscribe/${BUTTONDOWN.username}`;
---

<section id="newsletter" class="scroll-mt-20 border-t border-border/60 py-20 sm:py-24">
	<div class="mx-auto max-w-2xl px-4 text-center sm:px-6">
		<div
			class="mx-auto mb-6 flex size-12 items-center justify-center rounded-xl bg-muted text-foreground"
		>
			<Mail class="size-6" />
		</div>
		<h2 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
			Follow along.
		</h2>
		<p class="mx-auto mt-4 max-w-xl text-muted-foreground text-pretty">
			Occasional updates on new releases, features, and security. No account
			required, no tracking, and one click to unsubscribe.
		</p>

		{/* target="_blank" keeps this page open while Buttondown's response (CAPTCHA,
		    validation errors, confirmation) renders in a new tab. */}
		<form
			action={action}
			method="post"
			target="_blank"
			class="embeddable-buttondown-form mx-auto mt-8 flex w-full max-w-md flex-col gap-3 sm:flex-row"
		>
			<label for="newsletter-email" class="sr-only">Email address</label>
			<input
				id="newsletter-email"
				type="email"
				name="email"
				required
				autocomplete="email"
				placeholder="you@example.com"
				class="h-11 w-full flex-1 rounded-md border bg-background px-4 text-base shadow-xs transition-colors outline-none placeholder:text-muted-foreground focus-visible:border-outline focus-visible:ring-3 focus-visible:ring-outline/50"
			/>
			<input type="hidden" name="embed" value="1" />
			<Button type="submit" class="shrink-0">Subscribe</Button>
		</form>

		<p class="mt-3 text-sm text-muted-foreground">
			Subscribing opens a Buttondown tab to confirm your address.
		</p>
	</div>
</section>
