---
import BrandGithub from "@tabler/icons/outline/brand-github.svg";
import BrandMatrix from "@tabler/icons/outline/brand-matrix.svg";
import Mail from "@tabler/icons/outline/mail.svg";
import { LINKS, SITE } from "@/consts";

const ways = [
	{ icon: BrandGithub, label: "Ask on GitHub", href: `${LINKS.github}/issues` },
	{ icon: BrandMatrix, label: "Chat on Matrix", href: LINKS.matrix },
	{ icon: Mail, label: "Email us", href: `mailto:${SITE.contactEmail}` },
];
---

<section aria-labelledby="docs-help-title" class="rounded-xl border border-border bg-muted/30 p-6">
	<h2 id="docs-help-title" class="font-semibold">Still stuck?</h2>
	<p class="mt-1 text-sm text-muted-foreground">Ask and we'll help.</p>
	<ul class="mt-4 flex flex-wrap gap-2">
		{
			ways.map(({ icon: Icon, label, href }) => (
				<li>
					<a
						href={href}
						target={href.startsWith("http") ? "_blank" : undefined}
						rel={href.startsWith("http") ? "noopener" : undefined}
						class="inline-flex items-center gap-2 rounded-md border border-border bg-background px-3 py-2 text-sm font-medium transition-colors hover:bg-muted"
					>
						<Icon class="size-4" aria-hidden="true" />
						{label}
					</a>
				</li>
			))
		}
	</ul>
</section>
