---
import { type Doc, docHref, groupBySection } from "@/docs";

interface Props {
	docs: Doc[];
	currentId?: string;
}

const { docs, currentId } = Astro.props;
const groups = groupBySection(docs);

const link =
	"block rounded-md px-2 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground aria-[current=page]:bg-muted aria-[current=page]:font-medium aria-[current=page]:text-foreground";
---

<nav aria-label="Docs" class="flex flex-col gap-7 text-sm">
	{
		groups.map(({ section, docs }) => {
			const guides = docs.filter((d) => d.data.kind === "guide");
			const questions = docs.filter((d) => d.data.kind === "question");
			return (
				<div>
					<a
						href={`/docs#${section.id}`}
						class="px-2 font-semibold text-foreground hover:underline hover:underline-offset-2"
					>
						{section.title}
					</a>
					<ul class="mt-2 flex flex-col gap-0.5">
						{guides.map((doc) => (
							<li>
								<a
									href={docHref(doc)}
									class={link}
									aria-current={doc.id === currentId ? "page" : undefined}
								>
									{doc.data.title}
								</a>
							</li>
						))}
					</ul>
					{questions.length > 0 && (
						<>
							<p class="mt-3 px-2 text-xs font-medium tracking-wide text-muted-foreground uppercase">
								Questions
							</p>
							<ul class="mt-1 flex flex-col gap-0.5">
								{questions.map((doc) => (
									<li>
										<a
											href={docHref(doc)}
											class={link}
											aria-current={doc.id === currentId ? "page" : undefined}
										>
											{doc.data.title}
										</a>
									</li>
								))}
							</ul>
						</>
					)}
				</div>
			);
		})
	}
</nav>
