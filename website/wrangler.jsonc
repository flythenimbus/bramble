{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bramble-website",
	// Pins the runtime behaviour for functions/ (the release-download badge endpoint).
	"compatibility_date": "2026-07-28",
	"pages_build_output_dir": "dist",
	// The last good GitHub and App Store answers, shared by every location (functions/api/_cache.ts).
	"kv_namespaces": [{ "binding": "RELEASES_KV", "id": "237c1b61f92d46f7b3d86c26b7202c4a" }]
}
